# Copy this file to .env and adjust as needed.

# --- Web server ---
PORT=3000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to test from other devices on your network.
HOST=127.0.0.1
# Base URL used when generating shareable form links (leave blank to use the request's host)
PUBLIC_BASE_URL=

# Run pending database migrations automatically when the server starts
AUTO_MIGRATE=true

# --- File uploads ---
# Where files sent through forms are stored, and the largest size any form may allow (MB).
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# --- Sign in with Google ---
# Create an OAuth "Web application" client in Google Cloud Console and paste its Client ID here.
# Authorized JavaScript origins must include http://localhost:3000 (and later your real https address).
GOOGLE_CLIENT_ID=
# Local testing only: adds an email-only "developer sign-in" on localhost. Keep false on any real server.
DEV_LOGIN=false
SESSION_DAYS=30

# --- Email ---
# Leave SMTP_HOST empty to run in TEST MODE: nothing is sent, emails are saved to data/outbox
# and can be previewed in the admin.
#   Gmail:        SMTP_HOST=smtp.gmail.com     SMTP_PORT=587  (SMTP_PASS = a Google "App password")
#   Outlook/M365: SMTP_HOST=smtp.office365.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=StickyForms <no-reply@example.com>
MAIL_REPLY_TO=
# IMPORTANT before sending real emails: set PUBLIC_BASE_URL (above) to an address recipients can open.
# Links pointing to localhost / 127.0.0.1 only work on this computer.

# --- Database ---
# Local/dev: SQLite built into Node.js (zero setup, single file)
DB_CLIENT=sqlite
DB_FILE=./data/stickyforms.db

# Production-ready: PostgreSQL (run `npm install pg` first)
# DB_CLIENT=pg
# DATABASE_URL=postgres://stickyforms:stickyforms@localhost:5432/stickyforms
