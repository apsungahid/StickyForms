{
  "name": "stickyforms",
  "version": "0.1.0",
  "private": true,
  "description": "StickyForms.io - build customizable forms and collect submissions via personal links",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test",
    "set-owner": "node scripts/set-owner.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^11.2.0",
    "knex": "^3.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
